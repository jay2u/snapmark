{
  "name": "snapmark",
  "version": "1.0.0",
  "description": "Capture screenshots (visible area, region, full page, any window) and annotate them.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jay2u/snapmark.git"
  },
  "bugs": {
    "url": "https://github.com/jay2u/snapmark/issues"
  },
  "homepage": "https://github.com/jay2u/snapmark#readme",
  "keywords": [
    "chrome-extension",
    "screenshot",
    "annotation",
    "manifest-v3",
    "full-page-screenshot"
  ],
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "icons": "node scripts/make-icons.mjs",
    "dev": "vite build --watch",
    "build": "node scripts/make-icons.mjs && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "konva": "^10.9.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "fake-indexeddb": "^6.2.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
